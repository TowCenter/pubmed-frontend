# Production build (GitHub Pages) has no dev server, so there are no
# /api/articles.csv or /api/collections endpoints. Unset both here so the
# build falls back to the static public/data-with-xy-<collection>.csv and
# public/collections.json, exported fresh from Postgres at deploy time
# (npm run export-data, via the predeploy hook).
#
# This file overrides the dev values in .env for `vite build`. Safe to
# commit: it contains no secrets.
VITE_DATA_URL=
VITE_COLLECTIONS_URL=
