# Production build (GitHub Pages) has no dev server, so there is no
# /api/articles.csv endpoint. Unset VITE_DATA_URL here so the build falls
# back to the static public/data-with-xy.csv, which is exported fresh from
# Postgres at deploy time (npm run export-data, via the predeploy hook).
#
# This file overrides the dev value in .env for `vite build`. Safe to commit:
# it contains no secrets.
VITE_DATA_URL=
