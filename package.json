{
  "name": "svelte-visualization-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "export-data": "node --env-file=.env scripts/export-db.mjs",
    "load-neo4j": "node --env-file=.env scripts/load-neo4j.mjs",
    "build-coi-graph": "node --env-file=.env scripts/build-coi-graph.mjs",
    "predeploy": "npm run export-data && npm run build-coi-graph",
    "deploy": "vite build && gh-pages -d dist -b gh-pages"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^1.0.2",
    "gh-pages": "^6.3.0",
    "svelte": "^3.49.0",
    "vite": "^3.1.0"
  },
  "dependencies": {
    "d3-array": "^3.2.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "jszip": "^3.10.1",
    "neo4j-driver": "^6.1.0",
    "papaparse": "^5.5.2",
    "pg": "^8.21.0"
  }
}
